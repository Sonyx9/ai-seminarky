# Kopie → .env (necommitovat). Build čte PUBLIC_* proměnné.
# Endpoint formuláře = URL nasazené Apps Script Web App (backend/apps-script/README.md)
PUBLIC_FORM_ENDPOINT=
# GA4 Measurement ID (G-XXXXXXX). Prázdné = tag se nevloží (staging).
PUBLIC_GA4_ID=
# Ostrá doména (až bude) a staging
PROD_SITE=https://example.cz
STAGING_SITE=https://sonyx9.github.io
STAGING_BASE=/ai-seminarky
