---
import Icon from './Icon.astro';
import { site, nav, url } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="bg-teal-600 text-white mt-auto">
  <div class="container-site py-12 md:py-16 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-serif text-[22px] leading-tight mb-3">Kontrola a oprava závěrečných prací</p>
      <p class="text-white/85 text-[15px]">Konzultace, korektura a kontrola bakalářských a diplomových prací – i těch, u kterých škola namítla použití AI. Práci dopracováváme s vámi, ne za vás.</p>
    </div>
    <nav aria-label="Patička" class="flex flex-col gap-2 font-condensed text-[18px]">
      {nav.map((i) => <a href={url(i.href)} class="no-underline text-white hover:text-sand-200">{i.label}</a>)}
      <a href={url('/ochrana-osobnich-udaju/')} class="no-underline text-white/85 hover:text-sand-200 text-[16px] mt-2">Ochrana osobních údajů</a>
      <a href="#" class="no-underline text-white/85 hover:text-sand-200 text-[16px]" data-consent-open>Nastavení cookies</a>
    </nav>
    <div class="text-[15px] leading-relaxed">
      <p class="font-semibold text-white">{site.operator.name}</p>
      <p class="text-white/85">IČO {site.operator.ico}<br />{site.operator.address}</p>
      <p class="mt-3 flex flex-col gap-1">
        <a href={site.phoneHref} class="inline-flex items-center gap-2 text-white no-underline hover:text-sand-200"><Icon name="phone" size={16} />{site.phone}</a>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-white no-underline hover:text-sand-200"><Icon name="mail" size={16} />{site.email}</a>
      </p>
      <a href={url('/kontakt/#formular')} class="btn bg-coral-500 text-white hover:bg-coral-600 no-underline mt-5">Nezávazně poptat</a>
    </div>
  </div>
  <div class="border-t border-white/20">
    <div class="container-site py-4 text-[14px] text-white/75 flex flex-col md:flex-row md:justify-between gap-2">
      <span>© {year} {site.operator.name}</span>
      <span>Součást <a href={site.parentSite} class="text-white underline hover:text-sand-200" rel="noopener">topseminarky.cz</a></span>
    </div>
  </div>
</footer>
