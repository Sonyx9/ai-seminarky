---
/** Rozbalovací položka (karty situací, FAQ). Celý povrch aktivní, jednotné chování. */
import Icon from './Icon.astro';
interface Props { title: string; class?: string; titleClass?: string; name?: string }
const { title, class: cls = '', titleClass = '', name } = Astro.props;
---
<details class={`group bg-paper-000 border-b border-line-200 ${cls}`} name={name}>
  <summary class="list-none cursor-pointer flex items-start justify-between gap-4 py-5 text-left">
    <span class={`font-serif font-semibold text-[19px] leading-snug text-teal-600 ${titleClass}`}>{title}</span>
    <Icon name="chevron-down" class="shrink-0 mt-0.5 text-coral-600 transition-transform group-open:rotate-180" />
  </summary>
  <div class="pb-6 text-ink-700 flex flex-col gap-3 [&_p]:m-0">
    <slot />
  </div>
</details>
