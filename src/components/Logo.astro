---
/** Logo TOPseminarky.cz (PNG 768×150; vektorovou verzi doplnit, až bude k dispozici). */
import { url } from '../lib/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('/')} class={`inline-flex items-center no-underline ${cls}`} aria-label="TOPseminarky.cz – úvodní stránka">
  <img src={url('/img/logo-topseminarky.png')} alt="TOPseminarky.cz" width="768" height="150" class="h-9 w-auto sm:h-10" />
</a>
