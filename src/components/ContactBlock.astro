---
/** Krátký kontaktní blok na konci hlavních stránek (§2) + formulář. */
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { site } from '../lib/site';
interface Props { heading?: string }
const { heading } = Astro.props;
---
<section class="section bg-paper-000" id="kontakt" aria-labelledby="kontakt-h">
  <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div>
      <p class="eyebrow mb-3">Kontakt</p>
      <h2 id="kontakt-h" class="mb-4">Napište, <span class="mark">co se stalo</span>. Ozveme se do 24 hodin.</h2>
      <p class="text-ink-700 mb-6">Stačí pár vět a termín. Posudek nebo připomínky od školy pošlete až potom e-mailem – ve formuláři nic nahrávat nemusíte.</p>
      <ul class="flex flex-col gap-3 text-[16px]">
        <li class="flex items-center gap-3"><span class="w-10 h-10 shrink-0 rounded-full bg-teal-100 text-teal-600 inline-flex items-center justify-center"><Icon name="phone" size={18} /></span><a href={site.phoneHref} class="no-underline text-ink-900 hover:text-coral-600">{site.phone}</a></li>
        <li class="flex items-center gap-3"><span class="w-10 h-10 shrink-0 rounded-full bg-teal-100 text-teal-600 inline-flex items-center justify-center"><Icon name="mail" size={18} /></span><a href={`mailto:${site.email}`} class="no-underline text-ink-900 hover:text-coral-600">{site.email}</a></li>
        <li class="flex items-center gap-3"><span class="w-10 h-10 shrink-0 rounded-full bg-teal-100 text-teal-600 inline-flex items-center justify-center"><Icon name="clock" size={18} /></span><span class="text-ink-700">Odpověď {site.responseTime}, i o víkendu</span></li>
      </ul>
      <p class="mt-8 text-[14px] text-ink-500">{site.operator.name} · IČO {site.operator.ico} · {site.operator.address}</p>
    </div>
    <LeadForm heading={heading} />
  </div>
</section>
